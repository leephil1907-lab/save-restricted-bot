# Telegram API credentials (required)
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Bot token (required for the bot interface)
# Get this from @BotFather
TELEGRAM_BOT_TOKEN=

# User account (used when the bot needs access to content your bot account cannot access)
# The account must already have legitimate access to the source chat/channel.
TELEGRAM_PHONE_NUMBER=

# Optional runtime settings
PORT=8080
LOG_LEVEL=INFO
SESSION_DIR=/app/sessions
MEDIA_CACHE_DIR=/app/media-cache
CACHE_TTL_SECONDS=900
MAX_CACHE_ITEMS=100
TGFlow_ALLOWED_ORIGIN=*
