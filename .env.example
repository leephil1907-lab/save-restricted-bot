# Telegram API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Bot token from @BotFather. Required to receive requests and send results.
TELEGRAM_BOT_TOKEN=

# User authentication. Use a persisted Telethon session for non-interactive hosting.
# Preferred for Railway/containers:
TELEGRAM_SESSION_STRING=

# Optional for first-time/local interactive authentication only.
TELEGRAM_PHONE_NUMBER=

# Optional runtime settings
CACHE_TTL_SECONDS=900
CACHE_MAX_ITEMS=500
MEDIA_CACHE_DIR=/app/media-cache
TELEGRAM_SESSION_NAME=user_session
PORT=8080
